@Metadata.layer: #CORE

@UI.headerInfo:{
    typeName:       'Marketplace',
    typeNamePlural: 'Marketplaces',
    title:{ type: #STANDARD, value: 'ItemName' },
    description:{ type: #STANDARD, value: 'Status' }
}


annotate entity ZC_RPG_MARKETPLACE with
{
  @UI.facet: [
    {
      id: 'ItemDetails', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'ItemDetails',
      position: 10, targetQualifier: 'ItemDetails'
    },
    {
      id: 'Requirements', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'Requirements',
      position: 20, targetQualifier: 'Requirements'
    },
    {
      id: 'StatBonuses', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'Stat Bonuses',
      position: 30, targetQualifier: 'StatBonuses'
    }
  ]
  @UI.lineItem:       [{ position: 10, label: 'Item', importance: #HIGH }]
  @UI.selectionField: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.fieldGroup:     [{ qualifier: 'ItemDetails', position: 10, label: 'Item' }]
  ItemName;
  
  
  @UI.lineItem:       [{ position: 20, label: 'Description', importance: #LOW }]
  @UI.identification: [{ position: 20 }]
  @UI.fieldGroup:     [{ qualifier: 'ItemDetails', position: 20, label: 'Description' }]
  Description;

  @Consumption.valueHelpDefinition: [{
  entity: {
    name:    'ZI_ItemType_VH',
    element: 'ItemType'
  },
  additionalBinding: [{
    usage:        #RESULT
  }],
  useForValidation: true
  }]
  @UI.lineItem:       [{ position: 30, label: 'Type', importance: #LOW }]
  @UI.selectionField: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @UI.fieldGroup:     [{ qualifier: 'ItemDetails', position: 30, label: 'Type' }]
  ItemType;


  
  @Consumption.valueHelpDefinition: [{
  entity: {
    name:    'ZI_RPG_RARITY_VH',
    element: 'Rarity'
  },
  additionalBinding: [{
    usage:        #RESULT
  }],
  useForValidation: true
  }]
  @UI.lineItem:       [{ position: 40, label: 'Rarity' }]
  @UI.selectionField: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  @UI.fieldGroup:     [{ qualifier: 'ItemDetails', position: 40, label: 'Rarity' }]
  ItemRarity;
  
    @Consumption.valueHelpDefinition: [{
  entity: {
  name:    'ZI_ItemSubtype_VH',
  element: 'ItemSubtype'
  },
  additionalBinding: [{
  localElement: 'ItemType',
  element:      'ItemType',
  usage:        #FILTER
  }],
  useForValidation: true
  }]
  @UI.lineItem:       [{ position: 50, label: 'Subtype', importance: #LOW }]
  @UI.selectionField: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  @UI.fieldGroup:     [{ qualifier: 'ItemDetails', position: 50, label: 'Subtype' }]
  ItemSubtype;


  @UI.lineItem:       [{ position: 50, label: 'Required Level', importance: #MEDIUM }]
  @UI.identification: [{ position: 50 }]
  @UI.fieldGroup:     [{ qualifier: 'Requirements', position: 20, label: 'Required Level' }]
  RequiredLevel;

  @UI.lineItem:       [{ position: 60, label: 'Price', importance: #HIGH }]
  @UI.identification: [{ position: 60 }]
  @UI.fieldGroup:     [{ qualifier: 'Requirements', position: 20, label: 'Price' }]
  Price;

  @UI.lineItem:       [{ position: 70, label: 'Amount Available', importance: #HIGH }]
  @UI.identification: [{ position: 70 }]
  @UI.fieldGroup:     [{ qualifier: 'Requirements', position: 10, label: 'Amount Available' }]
  AmountAvailable;

  @UI.lineItem:       [{ position: 80, label: 'Status', importance: #HIGH }]
  @UI.identification: [{ position: 80, label: 'Item Status' }]
  @UI.fieldGroup:     [{ qualifier: 'Requirements', position: 10, label: 'Item Status' }]
  Status;
  @UI.identification: [{ position: 90 }]
  @UI.fieldGroup:     [{ qualifier: 'StatBonuses', position: 10, label: 'Strength Bonus' }]
  StrBonus;
  @UI.identification: [{ position: 100 }]
  @UI.fieldGroup:     [{ qualifier: 'StatBonuses', position: 20, label: 'Dexterity Bonus' }]
  DexBonus;
  @UI.identification: [{ position: 110 }]
  @UI.fieldGroup:     [{ qualifier: 'StatBonuses', position: 30, label: 'Constitution Bonus' }]
  ConBonus;
  @UI.identification: [{ position: 120 }]
  @UI.fieldGroup:     [{ qualifier: 'StatBonuses', position: 40, label: 'Intelligence Bonus' }]
  IntBonus;
  @UI.identification: [{ position: 130 }]
  @UI.fieldGroup:     [{ qualifier: 'StatBonuses', position: 50, label: 'Wisdom Bonus' }]
  WisBonus;
  @UI.identification: [{ position: 140 }]
  @UI.fieldGroup:     [{ qualifier: 'StatBonuses', position: 60, label: 'Charisma Bonus' }]
  ChaBonus;

}