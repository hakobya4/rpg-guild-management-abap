@Metadata.layer: #CORE

@UI.headerInfo:{
    typeName:       'Adventurer',
    typeNamePlural: 'Adventurers',
    title:{ type: #STANDARD, value: 'AdventurerName' },
    description:{ type: #STANDARD, value: 'AdventurerClass' }
}



annotate view ZC_RPG_ADVENTURER with
{
  @UI.facet: [
    {
      id: 'AdventurerDetails', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'Details',
      position: 10, targetQualifier: 'AdventurerDetails'
    },
        {
      id: 'AdvStats', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'Adventurer Stats',
      position: 20, targetQualifier: 'AdvStats'
    },
    {
      id: 'GameStats', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'Game Stats',
      position: 30, targetQualifier: 'GameStats'
    },

    {
      id: 'MyGuild', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'MyGuild',
      position: 40, targetQualifier: 'MyGuild'
    },
    {
      id: 'GuildInfo', purpose: #STANDARD,
      type: #LINEITEM_REFERENCE, label: 'Guilds Avialable',
      position: 50, targetElement: '_Guild'
    },
   {
  //    " Quests this adventurer has accepted
    id: 'MyQuests', purpose: #STANDARD,
    type: #LINEITEM_REFERENCE, label: 'My Quests',
    position: 60, targetElement: '_Quest'
  },
  {
  //    " All OPEN quests available to take
    id: 'AvailableQuests', purpose: #STANDARD,
    type: #LINEITEM_REFERENCE, label: 'Available Quests',
    position: 70, targetElement: '_AvailableQuest'
  },
     {
  //    " Items this adventurer has bought
    id: 'Inventory', purpose: #STANDARD,
    type: #LINEITEM_REFERENCE, label: 'Inventory',
    position: 80, targetElement: '_Inventory'
  },
  {
  //    " All items available to take
    id: 'Marektplace', purpose: #STANDARD,
    type: #LINEITEM_REFERENCE, label: 'Marketplace',
    position: 90, targetElement: '_Marketplace'
  },
  {
  id: 'NPCs', purpose: #STANDARD,
  type: #LINEITEM_REFERENCE, label: 'NPCs',
  position: 100, targetElement: '_NPC', targetQualifier: 'Embedded'
  }
  ]
  @UI.lineItem:       [{ position: 10, label: 'Name' }]
  @UI.selectionField: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.fieldGroup:     [{ qualifier: 'AdventurerDetails', position: 10, label: 'Name' }]
  AdventurerName;

  @Consumption.valueHelpDefinition: [{
    entity: {
      name:    'ZI_RPG_CLASS_VH',
      element: 'AdventurerClass'
    },
    additionalBinding: [{
      usage:        #RESULT
    }],
    useForValidation: true
  }]
  @UI.lineItem:       [{ position: 20, label: 'Class' }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.fieldGroup:     [{ qualifier: 'AdventurerDetails', position: 20, label: 'Class' }]
  AdventurerClass;

  @UI.lineItem:       [{ position: 10, label: 'Strenght' }]
  @UI.identification: [{ position: 10 }]
  @UI.fieldGroup:     [{ qualifier: 'AdvStats', position: 10, label: 'Strenght' }]
  AdvStr;

  @UI.lineItem:       [{ position: 15, label: 'Dexterity' }]
  @UI.identification: [{ position: 15 }]
  @UI.fieldGroup:     [{ qualifier: 'AdvStats', position: 15, label: 'Dexterity' }]
  AdvDex;

  @UI.lineItem:       [{ position: 20, label: 'Constitution' }]
  @UI.identification: [{ position: 20 }]
  @UI.fieldGroup:     [{ qualifier: 'AdvStats', position: 20, label: 'Constitution' }]
  AdvCon;

  @UI.lineItem:       [{ position: 25, label: 'Intelligence' }]
  @UI.identification: [{ position: 25 }]
  @UI.fieldGroup:     [{ qualifier: 'AdvStats', position: 25, label: 'Intelligence' }]
  AdvInt;

  @UI.lineItem:       [{ position: 30, label: 'Wisdom' }]
  @UI.identification: [{ position: 30 }]
  @UI.fieldGroup:     [{ qualifier: 'AdvStats', position: 30, label: 'Wisdom' }]
  AdvWis;

  @UI.lineItem:       [{ position: 35, label: 'Charisma' }]
  @UI.identification: [{ position: 35 }]
  @UI.fieldGroup:     [{ qualifier: 'AdvStats', position: 35, label: 'Charisma' }]
  AdvCha;

  @UI.lineItem:       [{ position: 30, label: 'Level' }]
  @UI.identification: [{ position: 30 }]
  @UI.fieldGroup:     [{ qualifier: 'GameStats', position: 10, label: 'Level' }]
  AdventurerLevel;

  @UI.lineItem:       [{ position: 40, label: 'XP' }]
  @UI.identification: [{ position: 40 }]
  @UI.fieldGroup:     [{ qualifier: 'GameStats', position: 20, label: 'Total XP' }]
  AdventurerXp;

  @UI.lineItem:       [{ position: 45, label: 'Gold' }]
  @UI.identification: [{ position: 45 }]
  @UI.fieldGroup:     [{ qualifier: 'GameStats', position: 20, label: 'Total Gold' }]
  AdventurerGold;

  @UI.lineItem:       [{ position: 50, label: 'MyGuild' }]
  @UI.identification: [{ position: 50, label: 'Current Guild' }]
  @UI.fieldGroup:     [{ qualifier: 'MyGuild', position: 10, label: 'Current Guild' }]
  GuildName;


  @UI.identification: [{
    position:   10,
    label:      'Join Guild',
    type:       #FOR_ACTION,
    dataAction: 'joinGuild'
  },
  {
    position:   20,
    label:      'Quit Guild',
    type:       #FOR_ACTION,
    dataAction: 'quitGuild'
  },
  {
    position:   30,
    label:      'Take Quest',
    type:       #FOR_ACTION,
    dataAction: 'acceptQuest'
  },
  {
    position:   40,
    label:      'Buy Item',
    type:       #FOR_ACTION,
    dataAction: 'buyItem'
    },
     {
    position:   50,
    label:      'Roll Stats',
    type:       #FOR_ACTION,
    dataAction: 'rollStats'
  }
    ]


  AdventurerId;

}