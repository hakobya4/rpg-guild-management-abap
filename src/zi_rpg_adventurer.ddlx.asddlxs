@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Adventurer',
  typeNamePlural: 'Adventurers',
  title: { type: #STANDARD, value: 'AdventurerName' },
  description: { type: #STANDARD, value: 'AdventurerClass' }
}
annotate view ZC_RPG_Adventurer with
{
  @UI.facet: [
    {
      id: 'Adventurer',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Adventurer',
      position: 10
    }
  ]

  @UI.lineItem: [ { position: 10, label: 'Name' } ]
  @UI.identification: [ { position: 10, label: 'Name' } ]
  @UI.selectionField: [ { position: 10 } ]
  AdventurerName;

  @UI.lineItem: [ { position: 20, label: 'Class' } ]
  @UI.identification: [ { position: 20, label: 'Class' } ]
  @UI.selectionField: [ { position: 20 } ]
  AdventurerClass;

  @UI.lineItem: [ { position: 30, label: 'Level' } ]
  @UI.identification: [ { position: 30, label: 'Level' } ]
  LevelValue;

  @UI.lineItem: [ { position: 40, label: 'Total XP' } ]
  @UI.identification: [ { position: 40, label: 'Total XP' } ]
  XPTotal;
}