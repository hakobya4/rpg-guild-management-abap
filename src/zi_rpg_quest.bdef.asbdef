managed with additional save implementation in class ZBP_I_RPG_QUEST unique;
strict ( 2 );
with draft;

define behavior for ZI_RPG_QUEST alias Quest
persistent table zrpg_quest
draft table zrpg_quest_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LastChangedAt
{
  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateQuestValues;
  }

  field ( readonly, numbering : managed ) QuestId;
  field ( readonly ) CreatedAt, CreatedBy, LastChangedAt,
  LastChangedBy, LocalLastChangedAt;
  field ( mandatory ) QuestName, RequiredLevel, XpReward, GoldReward, RequiredStat, DifficultyClass;

  // Lifecycle fields are only changed by the actions below
  field ( readonly ) Status, AdventurerId;

  // Assigns the quest to an adventurer
  action acceptQuest parameter ZI_RPG_ASSIGN_ADV_PARAM result [1] $self;
  // Complete button is enabled only while the quest is IN_PROGRESS
  action ( features : instance ) completeQuest result [1] $self;
  //Give up quest, button enabled while the quest is IN_PROGRESS
  action ( features : instance ) giveupQuest result [1] $self;

  // Shows the drop rate for this quest's loot
  action previewLootOdds result [0..*] ZI_RPG_LOOT_ODDS;


  validation validateQuestValues on save { create; field RequiredLevel, XpReward, GoldReward; }
  determination setInitialStatus on modify { create; }


  mapping for zrpg_quest
    {
      QuestId            = quest_id;
      QuestName          = quest_name;
      QuestTypeName      = quest_type_name;
      NpcId              = npc_id;
      Description        = description;
      RequiredLevel      = required_level;
      RequiredStat       = required_stat;
      DifficultyClass    = difficulty_class;
      XpReward           = xp_reward;
      GoldReward         = gold_reward;
      Status             = status;
      AdventurerId       = adventurer_id;
      CreatedAt          = created_at;
      CreatedBy          = created_by;
      LastChangedAt      = last_changed_at;
      LastChangedBy      = last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
    }
}