// Behavior Definition for ZI_RPG_Quest
managed implementation in class zbp_i_rpg_quest unique;
strict ( 2 );

define behavior for ZI_RPG_Quest alias Quest
persistent table zrpg_quest
lock master
authorization master ( instance )
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed ) QuestUUID;
  field ( mandatory ) QuestName, MinLevel, XPReward;

  mapping for zrpg_quest
  {
    QuestUUID = quest_uuid;
    QuestName = quest_name;
    Description = description;
    MinLevel = min_level;
    XPReward = xp_reward;
    RewardUUID = reward_uuid;
    ActiveStatus = active_status;
  }
}