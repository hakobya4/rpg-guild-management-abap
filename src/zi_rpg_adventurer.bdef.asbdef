// Behavior Definition for ZI_RPG_Adventurer
managed implementation in class zbp_i_rpg_adventurer unique;
strict ( 2 );

define behavior for ZI_RPG_Adventurer alias Adventurer
persistent table zrpg_adventurer
lock master
authorization master ( instance )
etag master LastChangedAt
{
  create;
  update;
  delete;

  field ( readonly, numbering : managed ) AdventurerUUID;
  field ( readonly ) CreatedAt, CreatedBy, LastChangedAt, LastChangedBy;
  field ( mandatory ) AdventurerName, AdventurerClass;

  mapping for zrpg_adventurer
  {
    AdventurerUUID = adventurer_uuid;
    GuildUUID = guild_uuid;
    AdventurerName = adventurer_name;
    AdventurerClass = adventurer_class;
    LevelValue = level_value;
    XPTotal = xp_total;
    ActiveStatus = active_status;
    CreatedAt = created_at;
    CreatedBy = created_by;
    LastChangedAt = last_changed_at;
    LastChangedBy = last_changed_by;
  }
}