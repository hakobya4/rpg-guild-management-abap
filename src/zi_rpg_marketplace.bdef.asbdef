managed implementation in class zbp_i_rpg_marketplace unique;
strict ( 2 );
with draft;

define behavior for ZI_RPG_MARKETPLACE alias Marketplace
persistent table zrpg_marketplace
draft table zrpg_market_d
lock master total etag LastChangedAt
authorization master ( global )
etag master LastChangedAt
{
  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateItemValues;
  }

  field ( readonly, numbering : managed ) ItemId;
  field ( readonly ) CreatedAt, CreatedBy, LastChangedAt,
  LastChangedBy, LocalLastChangedAt;
  field ( mandatory ) ItemName, RequiredLevel, Price, AmountAvailable, ItemType, ItemSubtype;
  field ( readonly ) Status, AdventurerId;
  action buyItem parameter ZI_RPG_BUY_MKT_PARAM result [1] $self;
  action restock parameter ZI_RPG_SELL_PARAM;


  validation validateItemValues on save { create; field ItemName, RequiredLevel, Price; }
  determination setDefaultItemValues on modify { create; }
  determination setDefaultSubtype on modify { field ItemType;}


  mapping for zrpg_marketplace
    {
      ItemId             = item_id;
      ItemName           = item_name;
      ItemType           = item_type;
      ItemSubtype        = item_subtype;
      Description        = description;
      RequiredLevel      = required_level;
      StrBonus           = str_bonus;
      DexBonus           = dex_bonus;
      ConBonus           = con_bonus;
      IntBonus           = int_bonus;
      WisBonus           = wis_bonus;
      ChaBonus           = cha_bonus;
      Price              = price;
      AmountAvailable    = amount_available;
      Status             = status;
      AdventurerId       = adventurerid;
      CreatedAt          = created_at;
      CreatedBy          = created_by;
      LastChangedAt      = last_changed_at;
      LastChangedBy      = last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
    }
}