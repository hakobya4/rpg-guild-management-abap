@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Adventurer Quest',
  typeNamePlural: 'Adventurer Quests',
  title: { type: #STANDARD, value: 'QuestStatus' },
  description: { type: #STANDARD, value: 'AdvQuestUUID' }
}
annotate view ZC_RPG_AdventurerQuest with
{
  @UI.facet: [
    {
      id: 'QuestLog',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Quest Log',
      position: 10
    }
  ]

  @UI.lineItem: [
    { position: 10, label: 'Adventurer' }
  ]
  @UI.identification: [
    { position: 10, label: 'Adventurer' }
  ]
  @UI.selectionField: [ { position: 10 } ]
  AdventurerUUID;

  @UI.lineItem: [
    { position: 20, label: 'Quest' }
  ]
  @UI.identification: [
    { position: 20, label: 'Quest' }
  ]
  @UI.selectionField: [ { position: 20 } ]
  QuestUUID;

  @UI.lineItem: [
    { position: 30, label: 'Status' }
  ]
  @UI.identification: [
    { position: 30, label: 'Status' }
  ]
  @UI.selectionField: [ { position: 30 } ]
  QuestStatus;

  @UI.lineItem: [
    { position: 40, label: 'Accepted At' }
  ]
  @UI.identification: [
    { position: 40, label: 'Accepted At' }
  ]
  AcceptedAt;

  @UI.lineItem: [
    { position: 50, label: 'Completed At' }
  ]
  @UI.identification: [
    { position: 50, label: 'Completed At' }
  ]
  CompletedAt;

  @UI.lineItem: [
    { position: 60, label: 'Reward Claimed' }
  ]
  @UI.identification: [
    { position: 60, label: 'Reward Claimed' }
  ]
  RewardClaimed;

  @UI.lineItem: [
    { position: 70, label: 'XP Granted' }
  ]
  @UI.identification: [
    { position: 70, label: 'XP Granted' }
  ]
  XPGranted;

  @UI.lineItem: [
    { type: #FOR_ACTION, dataAction: 'acceptQuest', label: 'Accept Quest', position: 80 },
    { type: #FOR_ACTION, dataAction: 'completeQuest', label: 'Complete Quest', position: 90 },
    { type: #FOR_ACTION, dataAction: 'claimReward', label: 'Claim Reward', position: 100 }
  ]
  AdvQuestUUID;
}
