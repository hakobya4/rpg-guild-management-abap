@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Guild',
  typeNamePlural: 'Guilds',
  title: { type: #STANDARD, value: 'GuildName' },
  description: { type: #STANDARD, value: 'HomeCity' }
}
annotate view ZC_RPG_Guild with
{
  @UI.facet: [
    {
      id: 'Guild',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Guild',
      position: 10
    }
  ]

  @UI.lineItem: [ { position: 10, label: 'Guild Name' } ]
  @UI.identification: [ { position: 10, label: 'Guild Name' } ]
  @UI.selectionField: [ { position: 10 } ]
  GuildName;

  @UI.lineItem: [ { position: 20, label: 'Home City' } ]
  @UI.identification: [ { position: 20, label: 'Home City' } ]
  @UI.selectionField: [ { position: 20 } ]
  HomeCity;

  @UI.lineItem: [ { position: 30, label: 'Reputation' } ]
  @UI.identification: [ { position: 30, label: 'Reputation' } ]
  Reputation;
}