projection;
strict ( 2 );
use draft;

define behavior for ZC_RPG_ADVENTURER alias Adventurer
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;
  use action joinGuild;
  use action quitGuild;
  use action acceptQuest;
  use action buyItem;
  use action rollStats;

  // Level and XP are managed by the application (defaults + quest rewards)
  field ( readonly ) AdventurerLevel, AdventurerXp, AdventurerGold;
  // Guild can be chosen on creation; afterwards only via joinGuild
  field ( readonly ) GuildId;
  side effects
  {
    action buyItem affects entity _Inventory, entity _Marketplace, field AdventurerGold;
    action acceptQuest affects entity _Quest, entity _AvailableQuest;
    action joinGuild affects field GuildName;
    action quitGuild affects field GuildName;
    action rollStats affects field AdvStr, field AdvDex, field AdvCon, field AdvInt, field AdvWis, field AdvCha;
  }

}