projection;
strict ( 2 );
use draft;

define behavior for ZC_RPG_ADVENTURER alias Adventurer
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;
  use action joinGuild;
  use action acceptQuest;

  // Level and XP are managed by the application (defaults + quest rewards)
  field ( readonly ) AdventurerLevel, AdventurerXp;
  // Guild can be chosen on creation; afterwards only via joinGuild
  field ( readonly : update ) GuildId;
}