@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Quest',
  typeNamePlural: 'Quests',
  title: { type: #STANDARD, value: 'QuestName' },
  description: { type: #STANDARD, value: 'Description' }
}
annotate view ZC_RPG_Quest with
{
  @UI.facet: [
    {
      id: 'Quest',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Quest',
      position: 10
    }
  ]

  @UI.lineItem: [ { position: 10, label: 'Quest Name' } ]
  @UI.identification: [ { position: 10, label: 'Quest Name' } ]
  @UI.selectionField: [ { position: 10 } ]
  QuestName;

  @UI.lineItem: [ { position: 20, label: 'Min Level' } ]
  @UI.identification: [ { position: 20, label: 'Min Level' } ]
  MinLevel;

  @UI.lineItem: [ { position: 30, label: 'XP Reward' } ]
  @UI.identification: [ { position: 30, label: 'XP Reward' } ]
  XPReward;

  @UI.lineItem: [ { position: 40, label: 'Active' } ]
  @UI.identification: [ { position: 40, label: 'Active' } ]
  ActiveStatus;
}