projection;
strict ( 2 );
use draft;

define behavior for ZC_RPG_QUEST alias Quest
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  // acceptQuest / completeQuest are intentionally NOT exposed here:
  // the quest workflow is driven from the Adventurer entity, which
  // delegates to the Quest interface actions internally.
}