projection;
strict ( 2 );
use draft;

define behavior for ZC_RPG_QUEST alias Quest
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action completeQuest;
  use action giveupQuest;
  side effects
  {
    action completeQuest affects entity _Adventurer;
    action giveupQuest affects entity _Adventurer;
  }
}