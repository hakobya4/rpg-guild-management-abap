managed implementation in class zbp_i_rpg_adventurerquest unique;
strict ( 2 );

define behavior for ZI_RPG_AdventurerQuest alias AdventurerQuest
persistent table zrpg_adv_quest
lock master
authorization master ( instance )
etag master LastChangedAt
{
  create;
  update;
  delete;

  field ( readonly ) AdvQuestUUID, CreatedAt, CreatedBy, LastChangedAt, LastChangedBy;
  field ( mandatory ) AdventurerUUID, QuestUUID;

  determination setDefaults on modify { create; }
  validation validateLevelRequirement on save { create; field AdventurerUUID, QuestUUID; }
  validation validateDuplicateQuest on save { create; field AdventurerUUID, QuestUUID; }

  action acceptQuest result [1] $self;
  action completeQuest result [1] $self;
  action claimReward result [1] $self;

  mapping for zrpg_adv_quest
  {
    AdvQuestUUID = adv_quest_uuid;
    AdventurerUUID = adventurer_uuid;
    QuestUUID = quest_uuid;
    QuestStatus = quest_status;
    AcceptedAt = accepted_at;
    CompletedAt = completed_at;
    RewardClaimed = reward_claimed;
    XPGranted = xp_granted;
    CreatedAt = created_at;
    CreatedBy = created_by;
    LastChangedAt = last_changed_at;
    LastChangedBy = last_changed_by;
  }
}