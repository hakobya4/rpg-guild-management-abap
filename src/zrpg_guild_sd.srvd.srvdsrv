@EndUserText.label: 'Guild Management Service Definition'
define service ZRPG_GUILD_SD {
  expose ZC_RPG_GUILD        as Guild;
  expose ZC_RPG_ADVENTURER   as Adventurer;
  expose ZC_RPG_QUEST        as Quest;
  expose ZI_RPG_CLASS_VH     as AdventurerClassVH;
  expose ZC_RPG_MARKETPLACE  as Marketplace;
  expose ZI_RPG_ITEM_VH      as ItemVH;
  expose ZI_RPG_INV_VH       as InventoryVH;
  expose ZC_RPG_INVENTORY    as Inventory;
  expose ZI_RPG_QUESTTYPE_VH as QuestTypeVH;
  expose ZC_RPG_LOOT_ITEMS   as LootItem;
  expose ZI_RPG_LOOT_ITEM_VH as LootItemVH;
  expose ZC_RPG_QUEST_LOOT   as QuestLoot;
  expose ZC_RPG_EXPEDITION   as Expedition;
  expose ZC_RPG_EXP_MEMBERS  as ExpeditionMember;
  expose ZC_RPG_NPC          as Npc;
  expose ZI_RPG_NPCROLE_VH   as NpcRoleVH;
}