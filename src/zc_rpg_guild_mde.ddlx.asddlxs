@Metadata.layer: #CORE

@UI.headerInfo:{
    typeName:       'Guild',
    typeNamePlural: 'Guilds',
    title:{ type: #STANDARD, value: 'GuildName' },
    description:{ type: #STANDARD, value: 'Description' }
}



annotate view ZC_RPG_GUILD with
{
  @UI.facet: [
    {
      id: 'GuildDetails', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'Guild Details',
      position: 10, targetQualifier: 'GuildDetails'
    },
    {
      id: 'Members', purpose: #STANDARD,
      type: #LINEITEM_REFERENCE, label: 'Members',
      position: 20, targetElement: '_Adventurer'
    }
  ]
  @UI.lineItem:       [{ position: 10, label: 'Guild Name' }]
  @UI.selectionField: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.fieldGroup:     [{ qualifier: 'GuildDetails', position: 10, label: 'Guild Name' }]
  GuildName;

  @UI.lineItem:       [{ position: 20, label: 'Description' }]
  @UI.identification: [{ position: 20 }]
  @UI.fieldGroup:     [{ qualifier: 'GuildDetails', position: 20, label: 'Description' }]
  Description;

}